# Environment Configuration for Eco-Tourism Dynamic Pricing System

# Security
SECRET_KEY=eco-tourism-secret-key-change-in-production-2026!
JWT_EXPIRATION_HOURS=24

# Database Configuration
# Option 1: MySQL (Recommended for Production & College Demo with XAMPP/MySQL)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecotourism_pricing
# Option 2: SQLite (Zero-configuration fallback, works out-of-the-box anywhere)
DATABASE_URL=sqlite:///ecotourism_pricing.db

# Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
FRONTEND_URL=http://localhost:5173

# ML Model & Scraping
MODEL_DIR=app/ml/saved_models
SCRAPING_TIMEOUT_SECONDS=10
USER_AGENT=EcoTourismEventCollector/1.0 (+http://localhost:5000)

# Real External Data Integrations
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
LIVE_DATA_REFRESH_INTERVAL_MINUTES=60

# Ticketmaster API (Optional - obtain free key at https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Dynamic Pricing Engine Constraints
MAX_PRICE_CHANGE_PCT=30.0
ENABLE_AUTO_PUBLIC_PRICING=false
DEFAULT_PREDICTION_MODEL=best
